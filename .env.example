# ---------------------------------------------------------------
# Painel de Projetos — Via3 Tecnologia
# Copie para .env e ajuste. NUNCA versione o .env com as senhas.
# ---------------------------------------------------------------

# Domínio público (usado pelo Caddy para emitir o certificado HTTPS)
DOMINIO=painel.via3tecnologia.com.br

PORT=3000
DATA_DIR=/app/data

# Quem pode entrar: domínios de e-mail autorizados, separados por vírgula.
# Deixe vazio para permitir qualquer e-mail (NÃO recomendado).
DOMINIOS_PERMITIDOS=via3tecnologia.com.br

# Administradores (criam/excluem projetos e gerenciam a equipe).
# O primeiro usuário a entrar também vira admin automaticamente.
ADMIN_EMAILS=lucas@via3tecnologia.com.br

# Sessão e código de acesso
SESSAO_DIAS=14
CODIGO_VALIDADE_MIN=10

# true quando o painel estiver atrás de HTTPS (o caso do Caddy). Em HTTP puro use false.
COOKIE_SECURE=true

# ------------------------- envio do código -------------------------
# log  = imprime o código no log do contêiner (use só para testar)
# smtp = envia o e-mail de verdade
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=painel@via3tecnologia.com.br
SMTP_PASS=coloque-a-senha-aqui
SMTP_FROM="Via3 Tecnologia" <painel@via3tecnologia.com.br>

APP_NOME=Painel de Projetos
APP_MARCA=Via3 Tecnologia
